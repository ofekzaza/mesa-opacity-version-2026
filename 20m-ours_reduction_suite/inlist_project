! 20m-ours_reduction_suite — minimal proof-of-concept.
!
! Purpose: prove that the "ours" porosity-reduction model can reach
! Si interactions and Fe-core formation (the logT_center > 9.6 stop in
! src/run_star_extras.f90).  This is the plain project base config
! (20m-ours_reduction) + the large-from-start network + solver robustness.
! Mixing follows the physical recipe of MESA's own 12M test-suite
! (12M_pre_ms_to_core_collapse/inlist_common): Ledoux + semiconvection +
! TDC MLT.  The test-suite's large overshoot block is intentionally omitted
! for simplicity; add it back if you want the full 12M recipe.
!
! Kept minimal: only controls that differ from MESA defaults are listed
! (plus the explicitly restored Ledoux/TDC/gold-tolerance lines).

&star_job

   ! begin with a pre-main sequence model
   create_pre_main_sequence_model = .true.

   ! save the final model (Si burn / Fe-core) + a final profile
   save_model_when_terminate = .false.
   write_profile_when_terminate = .true.
   filename_for_profile_when_terminate = 'profile_final.data'

   ! display on-screen plots
   pgstar_flag = .false.

   ! large network from the start — approx21 neglects electron captures
   ! before the end of O burn (Laplace+ 2021), so use the +Co56 net to
   ! make it through O/Si to the Fe core.
   change_net = .true.
   new_net_name = 'approx21_cr60_plus_co56.net'

/ ! end of star_job namelist


&eos

/ ! end of eos namelist


&kap

   use_Type2_opacities = .true.
   Zbase = 0.02

/ ! end of kap namelist


&controls

   terminal_interval = 1000
   history_interval = 50
   profile_interval = 50
   photo_interval = 1000
   max_num_profile_models = 9999

   ! starting specifications
   initial_mass = 20 ! in Msun units
   initial_z = 0.02

   ! stops: primary Si-burn stop lives in run_star_extras.f90
   ! (logT_center > 9.6).  Official backstop just above it (9.7) so a
   ! missed hook can never run away into collapse; fe_core_infall_limit is
   ! the physical Fe-core safeguard.
   log_max_temp_upper_limit = 9.7d0
   required_termination_code_string = 'log_max_temp_upper_limit'
   fe_core_infall_limit = 3d7
   xa_central_upper_limit_species(1) = 'fe56'
   xa_central_upper_limit(1) = 0.5
   max_age = 1d9
   max_model_number = 200000

   ! late-burning robustness (as in test_suite/*_pre_ms_to_core_collapse)
   set_min_D_mix = .true.
   min_D_mix = 1d-2
   limit_for_rel_error_in_energy_conservation = 1d-3
   hard_limit_for_rel_error_in_energy_conservation = 1d-2

   ! solver robustness: unlimited retries (default -1) + more Newton
   ! iterations per solve.  A hard retry cap previously killed the run.
   max_number_retries = -1
   solver_max_tries_before_reject = 100
   max_tries_for_retry = 50
   max_tries_after_5_retries = 50

   ! mixing: Ledoux + semiconvection, as in MESA's 12M test-suite recipe
   ! (12M_pre_ms_to_core_collapse/inlist_common).  Physically appropriate for
   ! a 20 M☉ star: the stabilizing composition gradient matters in core-He
   ! burning and sets the C/O-core mass that ultimately reaches Si/Fe core.
   use_Ledoux_criterion = .true.
   semiconvection_option = 'Langer_85 mixing; gradT = gradr'
   alpha_semiconvection = 1d-2

   ! solver / energy options (explicit; these are also MESA defaults)
   MLT_option = 'TDC'
   use_gold_tolerances = .true.
   energy_eqn_option = 'dedt'

   ! wind
   hot_wind_scheme = 'Dutch'
   Dutch_scaling_factor = 0.66

/ ! end of controls namelist
